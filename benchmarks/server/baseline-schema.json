{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solitude.local/schemas/server-baseline-v4.json",
  "title": "Solitude server reference baseline",
  "type": "object",
  "required": [
    "schemaVersion",
    "analysisPolicy",
    "commit",
    "profile",
    "machine",
    "nodeVersion",
    "platform",
    "cpu",
    "environment",
    "pluginIdentity",
    "protocol",
    "warmupSeconds",
    "measurementSeconds",
    "provisionalThresholds",
    "scenarios",
    "capacitySweep"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "analysisPolicy": { "type": "object" },
    "commit": { "type": "string" },
    "dirty": { "type": "boolean" },
    "profile": { "enum": ["reference", "smoke"] },
    "machine": { "type": "string" },
    "nodeVersion": { "type": "string" },
    "platform": { "type": "string" },
    "cpu": { "type": "string" },
    "environment": {
      "type": "object",
      "required": [
        "cpuAffinity",
        "loadGenerator",
        "loadGeneratorEnvironment",
        "machine",
        "nodeOptions",
        "pathLatencyMillis",
        "serverEnvironment",
        "topology"
      ],
      "properties": {
        "cpuAffinity": { "type": "string" },
        "loadGenerator": { "type": "string" },
        "loadGeneratorEnvironment": {
          "$ref": "#/$defs/environmentIdentity"
        },
        "machine": { "type": "string" },
        "nodeOptions": { "type": "string" },
        "pathLatencyMillis": { "$ref": "#/$defs/latencySummary" },
        "serverEnvironment": { "$ref": "#/$defs/environmentIdentity" },
        "topology": { "type": "string" }
      }
    },
    "pluginIdentity": { "type": "object" },
    "protocol": {
      "type": "object",
      "required": [
        "productionBuildCreatedOnce",
        "repetitions",
        "restartStrategy",
        "serverArtifactSha256",
        "serverEntry",
        "serverMode",
        "serverRestartedBetweenRepetitions",
        "serverUrl"
      ],
      "properties": {
        "productionBuildCreatedOnce": { "type": "boolean" },
        "repetitions": { "type": "integer", "minimum": 1 },
        "restartStrategy": { "enum": ["local-process", "manual", "command"] },
        "serverArtifactSha256": { "type": "string" },
        "serverEntry": { "type": "string" },
        "serverMode": { "enum": ["local", "remote"] },
        "serverRestartedBetweenRepetitions": { "type": "boolean" },
        "serverUrl": { "type": "string" }
      }
    },
    "warmupSeconds": { "type": "number", "minimum": 0 },
    "measurementSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "provisionalThresholds": { "type": "object" },
    "scenarios": { "$ref": "#/$defs/scenarioResults" },
    "capacitySweep": { "$ref": "#/$defs/scenarioResults" }
  },
  "$defs": {
    "environmentIdentity": {
      "type": "object",
      "required": [
        "commit",
        "container",
        "cpu",
        "cpuTopology",
        "dirty",
        "machine",
        "nodeOptions",
        "nodeVersion",
        "platform",
        "virtualization"
      ],
      "properties": {
        "commit": { "type": "string" },
        "container": { "$ref": "#/$defs/container" },
        "cpu": { "type": "string" },
        "cpuTopology": { "$ref": "#/$defs/cpuTopology" },
        "dirty": { "type": "boolean" },
        "machine": { "type": "string" },
        "nodeOptions": { "type": "string" },
        "nodeVersion": { "type": "string" },
        "platform": { "type": "string" },
        "virtualization": { "$ref": "#/$defs/virtualization" }
      }
    },
    "latencySummary": {
      "type": "object",
      "required": ["avg", "count", "max", "min", "p50", "p95", "p99"],
      "properties": {
        "avg": { "type": "number" },
        "count": { "const": 200 },
        "max": { "type": "number" },
        "min": { "type": "number" },
        "p50": { "type": "number" },
        "p95": { "type": "number" },
        "p99": { "type": "number" }
      }
    },
    "container": {
      "type": "object",
      "required": ["devcontainer", "engine", "present"],
      "properties": {
        "devcontainer": { "type": "boolean" },
        "engine": {
          "enum": ["containerd", "docker", "lxc", "none", "podman", "unknown"]
        },
        "present": { "type": "boolean" }
      }
    },
    "cpuTopology": {
      "type": "object",
      "required": [
        "hybrid",
        "logicalCores",
        "models",
        "physicalCores",
        "visibleLogicalCores"
      ],
      "properties": {
        "hybrid": { "type": ["boolean", "null"] },
        "logicalCores": { "type": "integer", "minimum": 1 },
        "models": { "type": "array", "items": { "type": "string" } },
        "physicalCores": { "type": ["integer", "null"], "minimum": 1 },
        "visibleLogicalCores": { "type": "integer", "minimum": 1 }
      }
    },
    "virtualization": {
      "type": "object",
      "required": ["hypervisorPresent", "runtime", "vbs"],
      "properties": {
        "hypervisorPresent": { "type": "boolean" },
        "runtime": {
          "enum": [
            "bare-metal",
            "virtual-machine",
            "wsl2",
            "windows-host",
            "unknown"
          ]
        },
        "vbs": {
          "type": ["object", "null"],
          "required": ["hvci", "status"],
          "properties": {
            "hvci": { "type": "boolean" },
            "status": { "enum": ["off", "enabled", "running", "unknown"] }
          }
        }
      }
    },
    "scenarioResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario", "runs", "summary"],
        "properties": {
          "scenario": { "type": "object" },
          "runs": { "type": "array" },
          "summary": {
            "type": "object",
            "required": [
              "confirmedSaturation",
              "medianRunRepetition",
              "saturationCount"
            ]
          }
        }
      }
    }
  }
}
